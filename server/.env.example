# Key names only. Real values go in server/.env, which is never committed.
# What each one does, and its default: README.md, "Configuration".

# Required
DATABASE_URL=
ANTHROPIC_API_KEY=

# Optional
PGSSL=
ANTHROPIC_MODEL=
PORT=

# Cost protection for a public deploy
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
CLAUDE_CALLS_PER_HOUR=
